
{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },

    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.netrc", "effect": "deny" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.pypirc", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*.netrc", "effect": "deny" },
    { "action": "edit", "resource": "*.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "*.pypirc", "effect": "deny" },

    { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "*/AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "opencode.json", "effect": "ask" },
    { "action": "edit", "resource": "*/opencode.json", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "*/.opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "docs/ENVIRONMENT.md", "effect": "ask" },
    { "action": "edit", "resource": "docs/WORKFLOW.md", "effect": "ask" },
    { "action": "edit", "resource": "licenses/*", "effect": "ask" },

    { "action": "shell", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "cmp *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "true", "effect": "allow" },
    { "action": "shell", "resource": "python3 *", "effect": "allow" },
    { "action": "shell", "resource": "PYTHONPATH=* python3 *", "effect": "allow" },

    { "action": "shell", "resource": "source /opt/ros/jazzy/setup.bash", "effect": "allow" },
    { "action": "shell", "resource": "source install/setup.bash", "effect": "allow" },
    { "action": "shell", "resource": "colcon build *", "effect": "allow" },
    { "action": "shell", "resource": "colcon test *", "effect": "allow" },
    { "action": "shell", "resource": "colcon test-result *", "effect": "allow" },
    { "action": "shell", "resource": "xacro *", "effect": "allow" },
    { "action": "shell", "resource": "cp scorpion_description/urdf/scorpion_robot.urdf.xacro /mnt/shared/scorPIon-model-creation/ros2_ws/src/scorpion_description/urdf/scorpion_robot.urdf.xacro", "effect": "allow" },
    { "action": "shell", "resource": "cp scorpion_description/tests/validate_xacro.py /mnt/shared/scorPIon-model-creation/ros2_ws/src/scorpion_description/tests/validate_xacro.py", "effect": "allow" },

    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "unlink *", "effect": "ask" },
    { "action": "shell", "resource": "shred *", "effect": "ask" },
    { "action": "shell", "resource": "find * -delete", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },

    { "action": "external_directory", "resource": "/mnt/shared/scorPIon-model-creation/*", "effect": "allow" },

    { "action": "execute", "resource": "*", "effect": "allow" },
    { "action": "blender_disable_telemetry", "resource": "*", "effect": "allow" },
    { "action": "blender_execute_blender_code", "resource": "*", "effect": "allow" },
    { "action": "blender_generate_3d", "resource": "*", "effect": "allow" },
    { "action": "blender_get_addon_status", "resource": "*", "effect": "allow" },
    { "action": "blender_get_scene_info", "resource": "*", "effect": "allow" },
    { "action": "blender_import_asset", "resource": "*", "effect": "allow" },
    { "action": "blender_record_trajectory_feedback", "resource": "*", "effect": "allow" },
    { "action": "blender_search_assets", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "blender": {
        "type": "local",
        "command": [
          "/home/human/.local/bin/uvx",
          "mcp-for-blender"
        ],
        "disabled": false,
        "environment": {
          "BLENDER_HOST": "127.0.0.1",
          "BLENDER_PORT": "9876",
          "BLENDER_MCP_SAFE_MODE": "1",
          "DISABLE_TELEMETRY": "true"
        }
      }
    }
  }
}
