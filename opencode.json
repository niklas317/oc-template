{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.netrc": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "question": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".git/**": "deny",
      "**/.git/**": "deny",
      "AGENTS.md": "ask",
      "**/AGENTS.md": "ask",
      "opencode.json": "ask",
      "**/opencode.json": "ask",
      ".opencode/**": "ask",
      "**/.opencode/**": "ask",
      "docs/ENVIRONMENT.md": "ask",
      "docs/WORKFLOW.md": "ask"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current*": "allow",
      "git rev-parse --show-toplevel*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "sudo": "deny",
      "sudo *": "deny"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "mcp": {}
}
